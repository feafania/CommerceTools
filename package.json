{
  "name": "CommerceTools",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --silent",
    "test:unit": "jest --testPathIgnorePatterns='__tests__/integration'",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "build": "cross-env NODE_ENV=production webpack --mode=production --stats-error-details",
    "start": "cross-env NODE_ENV=development webpack serve --mode=development --open --stats-error-details",
    "lint": "npx eslint 'src/**/*.{js,ts,tsx}' --ext .js,.ts,.tsx",
    "lint:fix": "npx eslint 'src/**/*.{js,ts,tsx}' --fix --ext .js,.ts,.tsx",
    "format": "npx prettier --write .",
    "ci:format": "npx prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-webpack-plugin": "^5.0.1",
    "globals": "^16.1.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.0.0",
    "prettier": "3.5.3",
    "raw-loader": "^4.0.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.3.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^8.9.0",
    "@commercetools/sdk-auth": "^5.0.1",
    "@commercetools/sdk-client-v2": "^3.0.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^16.5.0",
    "js-cookie": "^3.0.7",
    "process": "^0.11.10",
    "uuid": "^14.0.3"
  }
}
